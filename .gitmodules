[submodule "firmware/lib/cmsis_core"]
	path = firmware/lib/cmsis_core
	url = https://github.com/STMicroelectronics/cmsis_core
	shallow = true
[submodule "firmware/lib/cmsis_device_f4"]
	path = firmware/lib/cmsis_device_f4
	url = https://github.com/STMicroelectronics/cmsis_device_f4
[submodule "firmware/lib/stm32f4xx_hal_driver"]
	path = firmware/lib/stm32f4xx_hal_driver
	url = https://github.com/STMicroelectronics/stm32f4xx_hal_driver
[submodule "firmware/lib/tinyusb"]
	path = firmware/lib/tinyusb
	url = https://github.com/hathach/tinyusb
	shallow = true
